generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  RENTER
  DRIVER
  CUSTOMER
}

enum KycStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum TrustBadge {
  NOT_VERIFIED
  UNDER_VALIDATION
  VERIFIED
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  CVT
}

enum VehicleStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String
  phone           String?
  avatarUrl       String?
  role            UserRole         @default(CUSTOMER)
  kycStatus       KycStatus        @default(PENDING)
  passwordHash    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  renterProfile   RenterProfile?
  driverProfile   DriverProfile?
  customerProfile CustomerProfile?
  sessions        Session[]
  conversations   ConversationParticipant[]
  sentMessages    Message[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RenterProfile {
  id                 String     @id @default(cuid())
  userId             String     @unique
  companyName        String
  businessPermitUrl  String?
  companyRegUrl      String?
  taxIdNumber        String?
  bankAccountDetails String?
  trustBadge         TrustBadge @default(NOT_VERIFIED)
  commissionRate     Float      @default(0.05)
  penaltyFlags       Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]
  bookings Booking[]
}

model DriverProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  renterId           String
  licenseUrl         String?
  backgroundCheckUrl String?
  kycStatus          KycStatus @default(PENDING)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]
}

model CustomerProfile {
  id             String    @id @default(cuid())
  userId         String    @unique
  licenseUrl     String?
  licenseBackUrl String?
  secondaryIdUrl String?
  kycStatus      KycStatus @default(PENDING)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]
  reviews  Review[]
}

model Vehicle {
  id               String           @id @default(cuid())
  renterId         String
  make             String
  model            String
  year             Int
  plateNumber      String           @unique
  description      String?
  fuelType         FuelType
  transmission     TransmissionType
  seatingCapacity  Int
  dailyRate        Float
  mileageLimit     Int?
  imageUrls        String           @default("[]")
  vehiclePhotos    String           @default("{}")
  registrationDocs String           @default("{}")
  tags             String           @default("[]")
  operatingLocation String?
  operatingLat     Float?
  operatingLng     Float?
  status           VehicleStatus    @default(AVAILABLE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  renter   RenterProfile @relation(fields: [renterId], references: [id], onDelete: Cascade)
  bookings Booking[]
  reviews  Review[]

  @@index([renterId])
  @@index([status])
}

model Booking {
  id              String        @id @default(cuid())
  vehicleId       String
  customerId      String
  renterId        String
  driverId        String?
  pickupLocation  String
  pickupLat       Float?
  pickupLng       Float?
  startDate       DateTime
  endDate         DateTime
  dailyRate       Float
  platformFeeRate Float         @default(0.05)
  addonsAmount    Float         @default(0)
  totalAmount     Float
  platformFee     Float
  status          BookingStatus @default(PENDING)
  reservedUntil   DateTime?
  qrCode          String?
  referenceNumber String        @unique @default(cuid())
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  vehicle  Vehicle         @relation(fields: [vehicleId], references: [id])
  customer CustomerProfile @relation(fields: [customerId], references: [id])
  renter   RenterProfile   @relation(fields: [renterId], references: [id])
  driver   DriverProfile?  @relation(fields: [driverId], references: [id])
  payment       Payment?
  review        Review?
  renterReview  RenterReview?
  conversations Conversation[]

  @@index([vehicleId, startDate, endDate])
  @@index([customerId])
  @@index([renterId])
  @@index([status])
}

model Payment {
  id            String    @id @default(cuid())
  bookingId     String    @unique
  amount        Float
  currency      String    @default("PHP")
  provider      String
  providerRef   String?
  status        String    @default("PENDING")
  paidAt        DateTime?
  refundedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Review {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  vehicleId  String
  reviewerId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  booking  Booking         @relation(fields: [bookingId], references: [id])
  vehicle  Vehicle         @relation(fields: [vehicleId], references: [id])
  reviewer CustomerProfile @relation(fields: [reviewerId], references: [id])
}

model RenterReview {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  customerId String
  renterId   String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
}

model Dispute {
  id          String   @id @default(cuid())
  bookingId   String
  reporterId  String
  description String
  status      String   @default("OPEN")
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KnowledgeBase {
  id        String   @id @default(cuid())
  category  String
  question  String
  answer    String
  keywords  String
  createdAt DateTime @default(now())
}

model LegalPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Feedback {
  id          String   @id @default(cuid())
  name        String
  email       String
  subject     String
  category    String   @default("Feedback")
  message     String
  attachmentUrl String?
  status      String   @default("NEW")
  adminReply  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Conversation {
  id        String   @id @default(cuid())
  bookingId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking      Booking?                  @relation(fields: [bookingId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]

  @@index([bookingId])
  @@index([updatedAt])
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model HomepageConfig {
  id           String   @id @default(cuid())
  slides       String   @default("[]")
  featuredMode String   @default("AUTO")
  featuredIds  String   @default("[]")
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}
